<Window x:Class="ND_Explorer.Views.StorageAnalyzerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ND_Explorer.Controls"
        Title="저장 공간 분석"
        Width="1180" Height="780" MinWidth="820" MinHeight="560"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner"
        Closed="Window_OnClosed">
    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Bottom" Background="#12151B"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                    Padding="10,5,10,6">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <ContentPresenter ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="#20252E" />
            <Setter Property="BorderBrush" Value="#323947" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEDA2;" FontFamily="Segoe Fluent Icons"
                                           Foreground="{TemplateBinding Foreground}" Margin="0,0,8,0" />
                                <ContentPresenter ContentSource="Header" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#1C212A" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#3A4352" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#99000000" BlurRadius="12" ShadowDepth="3" />
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuBorder" Background="{TemplateBinding Background}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="18,10">
            <Grid>
                <StackPanel>
                    <TextBlock Text="저장 공간 분석" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="사각형이 클수록 더 많은 공간을 사용합니다. 폴더를 클릭하면 사각형 안에 하위 항목을 펼칩니다."
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Width="12" Height="12" CornerRadius="2" Background="#315D9E" Margin="0,0,6,0" />
                    <TextBlock Text="폴더" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,14,0" />
                    <Border Width="12" Height="12" CornerRadius="2" Background="#6A4D91" Margin="0,0,6,0" />
                    <TextBlock Text="파일" Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1"
                    ItemsSource="{Binding Drives}"
                    SelectedItem="{Binding SelectedDrive}"
                    TabStripPlacement="Bottom">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding TabLabel}" FontWeight="SemiBold" />
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="34" />
                        </Grid.RowDefinitions>

                        <Border Background="#171A20" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1" Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&#xE74A;" FontFamily="Segoe Fluent Icons" Width="36" Padding="0"
                                            ToolTip="상위 폴더" Command="{Binding UpCommand}" />
                                    <Button Content="&#xE72C;" FontFamily="Segoe Fluent Icons" Width="36" Padding="0"
                                            ToolTip="새로 고침" Command="{Binding RefreshCommand}" />
                                    <Button Content="취소" MinWidth="54" ToolTip="현재 분석 취소"
                                            Command="{Binding CancelCommand}" />
                                </StackPanel>

                                <Border Grid.Column="1" Margin="12,0" Padding="12,0"
                                        Background="#0E1116" BorderBrush="#303744" BorderThickness="1" CornerRadius="6">
                                    <TextBlock Text="{Binding CurrentPath}" TextTrimming="CharacterEllipsis"
                                               FontFamily="Consolas" FontSize="12" />
                                </Border>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding DriveDetails}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ProgressBar Grid.Row="1" IsIndeterminate="True"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Border Grid.Row="2" Margin="10" Background="#0A0C10"
                                BorderBrush="#303744" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                            <controls:StorageTreemapControl ItemsSource="{Binding Entries}"
                                                            SelectedEntry="{Binding SelectedEntry, Mode=TwoWay}"
                                                            EntryInvoked="Treemap_OnEntryInvoked"
                                                            OpenInNdExplorerRequested="Treemap_OnOpenInNdExplorerRequested"
                                                            OpenInWindowsExplorerRequested="Treemap_OnOpenInWindowsExplorerRequested" />
                        </Border>

                        <Border Grid.Row="3" Background="#15181E"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="14,0">
                            <TextBlock Text="{Binding SelectedEntryDetails}" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </TabControl.ContentTemplate>
        </TabControl>
    </Grid>
</Window>
