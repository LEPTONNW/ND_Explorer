<Window x:Class="ND_Explorer.Views.VideoPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="동영상 플레이어"
        Width="1100" Height="720" MinWidth="720" MinHeight="460"
        Background="#050608" Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        Closed="Window_OnClosed">
    <Window.Resources>
        <Style x:Key="PlayerButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#232936" />
            <Setter Property="BorderBrush" Value="#364052" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="56" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#315D9E" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#244A80" />
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="ButtonBorder" Property="RenderTransformOrigin" Value="0.5,0.5" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryPlayerButtonStyle" TargetType="Button" BasedOn="{StaticResource PlayerButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource SelectedBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="PlayerToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="#1C222C" />
            <Setter Property="BorderBrush" Value="#364052" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="68" />
            <Setter Property="Margin" Value="6,0,3,0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8EE;" FontFamily="Segoe Fluent Icons"
                                           Foreground="{TemplateBinding Foreground}" Margin="0,0,7,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#293343" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#294E84" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayerSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" VerticalAlignment="Center" Orientation="Horizontal">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Background="{DynamicResource AccentBrush}"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" Background="{TemplateBinding Background}" CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Background="#343B48"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" Background="{TemplateBinding Background}" CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="15" Height="15">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbVisual"
                                                        Background="White"
                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                        BorderThickness="3"
                                                        CornerRadius="8">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="7" ShadowDepth="0" Color="#99000000" />
                                                    </Border.Effect>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbVisual" Property="Background" Value="#DDE9FF" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbVisual" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="ThumbVisual" Property="BorderBrush" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <Border Background="#151922"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="4" Height="18" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
                    <TextBlock x:Name="FileNameText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Content="전체화면" ToolTip="전체화면 (Enter 또는 F11)"
                        Style="{StaticResource PlayerButtonStyle}"
                        Height="30" MinWidth="76" Padding="10,0" Margin="0"
                        HorizontalAlignment="Right" Click="Fullscreen_OnClick" />
            </Grid>
        </Border>

        <vlc:VideoView x:Name="VideoView" Grid.Row="1" Background="Black">
            <Grid Background="Transparent"
                  ToolTip="끌어서 창 이동"
                  MouseLeftButtonDown="VideoSurface_OnMouseLeftButtonDown" />
        </vlc:VideoView>

        <Border Grid.Row="2" Background="#151922"
                BorderBrush="#303744" BorderThickness="0,1,0,0" Padding="18,10,18,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="48" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="58" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentTimeText" Text="00:00" FontFamily="Consolas"
                               FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                    <Slider x:Name="TimelineSlider" Grid.Column="1" Margin="8,0"
                            Style="{StaticResource PlayerSliderStyle}"
                            Minimum="0" Maximum="1"
                            PreviewMouseLeftButtonDown="Timeline_OnPreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="Timeline_OnPreviewMouseLeftButtonUp" />
                    <TextBlock x:Name="DurationText" Grid.Column="2" Text="00:00" FontFamily="Consolas"
                               HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="-10초" ToolTip="10초 뒤로 (Ctrl: 30초, Shift: 1분)"
                                Style="{StaticResource PlayerButtonStyle}" Click="Back10_OnClick" />
                        <Button x:Name="PlayPauseButton" Content="▶  재생" ToolTip="재생/일시정지 (Space)"
                                Style="{StaticResource PrimaryPlayerButtonStyle}" Click="PlayPause_OnClick" />
                        <Button Content="■  정지" ToolTip="정지"
                                Style="{StaticResource PlayerButtonStyle}" Click="Stop_OnClick" />
                        <Button Content="+10초" ToolTip="10초 앞으로 (Ctrl: 30초, Shift: 1분)"
                                Style="{StaticResource PlayerButtonStyle}" Click="Forward10_OnClick" />
                        <ToggleButton x:Name="RepeatButton" Content="반복" ToolTip="반복 재생"
                                      Style="{StaticResource PlayerToggleStyle}"
                                      Checked="Repeat_OnChanged" Unchecked="Repeat_OnChanged" />
                    </StackPanel>

                    <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="#1C222C" BorderBrush="#303947" BorderThickness="1"
                            CornerRadius="9" Padding="10,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons"
                                       Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,6,0" />
                            <Slider x:Name="VolumeSlider" Width="80"
                                    Style="{StaticResource PlayerSliderStyle}"
                                    Minimum="0" Maximum="100" Value="80"
                                    ValueChanged="VolumeSlider_OnValueChanged" />
                            <TextBlock x:Name="VolumeText" Width="34" Text="80%" FontFamily="Consolas"
                                       HorizontalAlignment="Right" TextAlignment="Right" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="2"
                           Text="Space 재생/일시정지  ·  ← → 10초  ·  Ctrl 30초  ·  Shift 1분  ·  ↑ ↓ 음량  ·  Enter 전체화면  ·  Esc 최소화"
                           HorizontalAlignment="Center" FontSize="10.5"
                           Foreground="#768195" />
            </Grid>
        </Border>
    </Grid>
</Window>
