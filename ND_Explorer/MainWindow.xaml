<Window x:Class="ND_Explorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ND Explorer"
        Width="1180"
        Height="760"
        MinWidth="1050"
        MinHeight="520"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_OnLoaded"
        Closed="Window_OnClosed"
        PreviewMouseDown="Window_OnPreviewMouseDown"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Alt" Command="{Binding Explorer.BackCommand}" />
        <KeyBinding Key="Right" Modifiers="Alt" Command="{Binding Explorer.ForwardCommand}" />
        <KeyBinding Key="Up" Modifiers="Alt" Command="{Binding Explorer.UpCommand}" />
        <KeyBinding Key="F5" Command="{Binding Explorer.RefreshCommand}" />
    </Window.InputBindings>

    <Grid DataContext="{Binding Explorer}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="78" Height="28" CornerRadius="7"
                        BorderBrush="#303642" BorderThickness="1"
                        ToolTip="ND Explorer" SnapsToDevicePixels="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#11141A" Offset="0" />
                            <GradientStop Color="#20252E" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid ClipToBounds="True">
                        <TextBlock Text="ND EXP" FontFamily="Bahnschrift SemiBold" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#080A0E" Margin="0,-1,0,1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="ND EXP" FontFamily="Bahnschrift SemiBold" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#657083" Margin="0,1,0,-1" Opacity="0.7"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="ND EXP" FontFamily="Bahnschrift SemiBold" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#252B35"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Margin="12,6,0,0" Padding="14,0"
                        Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0"
                        CornerRadius="6,6,0,0">
                    <DockPanel LastChildFill="True">
                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" />
                        <TextBlock Text="{Binding CurrentPath, TargetNullValue=홈}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="저장 공간 분석" MinWidth="116" Margin="8,4,0,4"
                            ToolTip="드라이브별 저장 공간 사용량 분석"
                            Click="OpenStorageAnalyzer_OnClick" />
                    <Button Content="라이브러리 라이센스 고지" MinWidth="150" Margin="8,4,0,4"
                            Click="OpenSourceNotices_OnClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#x2190;" ToolTip="뒤로 (Backspace / Alt+← / 마우스 뒤로)" Command="{Binding BackCommand}" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#x2192;" ToolTip="앞으로 (Alt+→ / 마우스 앞으로)" Command="{Binding ForwardCommand}" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#x2191;" ToolTip="상위 폴더 (Alt+↑)" Command="{Binding UpCommand}" />
                </StackPanel>

                <Border Grid.Column="1" Width="1" Margin="8,3" Background="{DynamicResource BorderBrush}" />
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#x21BB;" ToolTip="새로 고침 (F5)" Command="{Binding RefreshCommand}" />

                <TextBox x:Name="AddressBox"
                         Grid.Column="3"
                         Margin="8,0"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="경로를 입력하고 Enter 키를 누르세요">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding NavigateCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="4" Content="이동" MinWidth="58" Command="{Binding NavigateCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="160" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="300" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" Padding="10,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="빠른 접근" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,4,0,6" />
                        <ItemsControl ItemsSource="{Binding Favorites}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.Explorer.NavigateToLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            ToolTip="{Binding Path}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator />
                        <TextBlock Text="드라이브" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="10,4,0,6" />
                        <ItemsControl ItemsSource="{Binding Drives}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.Explorer.NavigateToLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            ToolTip="{Binding Path}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Separator />
                        <TextBlock Text="최근 위치" Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="11" FontWeight="SemiBold" Margin="10,4,0,6" />
                        <ItemsControl ItemsSource="{Binding RecentLocations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.Explorer.NavigateToLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            HorizontalContentAlignment="Stretch"
                                            ToolTip="{Binding Path}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,5">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="새 폴더" ToolTip="새 폴더 (Ctrl+Shift+N)" Command="{Binding NewFolderCommand}" />
                        <Button Content="이름 바꾸기" ToolTip="이름 바꾸기 (F2)" Command="{Binding RenameCommand}" />
                        <Border Width="1" Margin="7,3" Background="{DynamicResource BorderBrush}" />
                        <Button Content="복사" ToolTip="복사 (Ctrl+C)" Command="{Binding CopyCommand}" />
                        <Button Content="잘라내기" ToolTip="잘라내기 (Ctrl+X)" Command="{Binding CutCommand}" />
                        <Button Content="붙여넣기" ToolTip="붙여넣기 (Ctrl+V)" Command="{Binding PasteCommand}" />
                        <Border Width="1" Margin="7,3" Background="{DynamicResource BorderBrush}" />
                        <Button Content="삭제" ToolTip="휴지통으로 보내기 (Delete)" Command="{Binding DeleteCommand}" />
                        <Button Content="작업 취소" ToolTip="진행 중인 작업 취소 (Esc)" Command="{Binding CancelOperationCommand}" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource WindowBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <TextBox x:Name="FilterBox"
                                     Padding="32,6,30,6"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="현재 폴더에서 이름으로 필터 (Ctrl+F)" />
                            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource SecondaryTextBrush}"
                                       HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False" />
                            <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10"
                                    Width="26" Height="26" Padding="0" HorizontalAlignment="Right" Margin="0,0,3,0"
                                    Command="{Binding ClearFilterCommand}" ToolTip="필터 지우기" />
                        </Grid>

                        <ComboBox Grid.Column="1" Width="116" Margin="10,0,0,0"
                                  ItemsSource="{Binding SortOptions}"
                                  SelectedItem="{Binding SelectedSortOption}"
                                  DisplayMemberPath="Label" />
                        <CheckBox Grid.Column="2" Margin="12,0,0,0" Content="내림차순" IsChecked="{Binding IsSortDescending}" />
                        <CheckBox Grid.Column="3" Margin="16,0,4,0" Content="숨김 항목" IsChecked="{Binding ShowHiddenItems}" />
                    </Grid>
                </Border>

                <ProgressBar Grid.Row="2" Height="2" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Grid Grid.Row="3">
                    <DataGrid x:Name="FileGrid"
                              ItemsSource="{Binding ItemsView}"
                              SelectedItem="{Binding SelectedItem}"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              AllowDrop="True"
                              SelectionChanged="FileGrid_OnSelectionChanged"
                              PreviewMouseRightButtonDown="FileGrid_OnPreviewMouseRightButtonDown"
                              PreviewMouseLeftButtonDown="FileGrid_OnPreviewMouseLeftButtonDown"
                              MouseMove="FileGrid_OnMouseMove"
                              PreviewDragOver="FileGrid_OnPreviewDragOver"
                              Drop="FileGrid_OnDrop"
                              MouseDoubleClick="FileGrid_OnMouseDoubleClick"
                              PreviewTextInput="FileGrid_OnPreviewTextInput"
                              KeyDown="FileGrid_OnKeyDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="열기" Command="{Binding OpenItemCommand}"
                                          CommandParameter="{Binding SelectedItem}" />
                                <Separator Style="{StaticResource ContextMenuSeparatorStyle}" />
                                <MenuItem Header="복사" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                                <MenuItem Header="잘라내기" Command="{Binding CutCommand}" InputGestureText="Ctrl+X" />
                                <MenuItem Header="붙여넣기" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                                <Separator Style="{StaticResource ContextMenuSeparatorStyle}" />
                                <MenuItem Header="이름 바꾸기" Command="{Binding RenameCommand}" InputGestureText="F2" />
                                <MenuItem Header="삭제" Command="{Binding DeleteCommand}" InputGestureText="Delete" />
                                <MenuItem Header="영구 삭제" Command="{Binding PermanentDeleteCommand}" InputGestureText="Shift+Delete" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="*" MinWidth="220" />
                            <DataGridTextColumn Header="수정한 날짜" Binding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="155" />
                            <DataGridTextColumn Header="유형" Binding="{Binding TypeName}" Width="130" />
                            <DataGridTextColumn Header="크기" Binding="{Binding SizeText}" Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Margin="24" Padding="18,12" CornerRadius="6"
                            Background="{DynamicResource ElevatedBackgroundBrush}"
                            BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA39;" FontFamily="Segoe Fluent Icons" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" MaxWidth="520" />
                        </StackPanel>
                    </Border>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons" FontSize="34"
                                   Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock Text="표시할 항목이 없습니다" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Column="3" Background="{DynamicResource BorderBrush}" />

            <Border Grid.Column="4" Background="{DynamicResource PanelBackgroundBrush}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="240" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="미리 보기" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Border Grid.Row="1" Background="#090A0D" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="8">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasImagePreview}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasImagePreview}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE8B2;" FontFamily="Segoe Fluent Icons" FontSize="42"
                                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="0,12,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="파일을 선택하면 여기에 미리보기가 표시됩니다." />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVideoSelected}" Value="True">
                                                    <Setter Property="Text" Value="동영상 재생기를 열어 바로 재생할 수 있습니다." />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsImageSelected}" Value="True">
                                                    <Setter Property="Text" Value="이미지 미리보기를 불러오는 중입니다." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <ProgressBar Height="2" IsIndeterminate="True" VerticalAlignment="Top"
                                         Visibility="{Binding IsPreviewLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2" Text="{Binding SelectedItem.Name}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,14,0,4" />
                    <StackPanel Grid.Row="3">
                        <TextBlock Text="{Binding SelectedItem.TypeName}" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding SelectedItem.SizeText}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding PreviewError}" Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>

                    <Button Grid.Row="4" Content="{Binding OpenActionText}" Command="{Binding OpenItemCommand}"
                            CommandParameter="{Binding SelectedItem}" VerticalAlignment="Bottom"
                            Background="{DynamicResource AccentBrush}" Foreground="White" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" />
                <TextBlock Text="ND Explorer · Single pane preview" Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="11" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
